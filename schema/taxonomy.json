{
  "version": "2.8.0",
  "name": "VideoToolbox",
  "include": [
    "README.md",
    "AGENTS.md",
    "DEVELOPMENT.md",
    "CHANGELOG.md"
  ],
  "frontmatter_exempt": {
    "names": [
      "AGENTS.md",
      "CHANGELOG.md",
      "DEVELOPMENT.md",
      "README.md"
    ],
    "paths": []
  },
  "types": [
    "tutorial",
    "how-to",
    "reference",
    "explanation"
  ],
  "kinds": [
    "standard",
    "decision",
    "index",
    "note",
    "glossary",
    "report",
    "pitfall"
  ],
  "statuses": [
    "draft",
    "active",
    "resolved",
    "superseded",
    "archived"
  ],
  "tiers": [
    "normal",
    "critical"
  ],
  "confidences": [
    "low",
    "medium",
    "high"
  ],
  "topics": [
    "development",
    "governance"
  ],
  "relations": {
    "depends-on": {
      "direction": "directed",
      "inverse": "depended-on-by",
      "transitive": false
    },
    "extends": {
      "direction": "directed",
      "inverse": "extended-by",
      "transitive": true
    },
    "spawned-from": {
      "direction": "directed",
      "inverse": "spawned",
      "transitive": false
    },
    "supersedes": {
      "direction": "directed",
      "inverse": "superseded-by",
      "transitive": false
    },
    "contradicts": {
      "direction": "symmetric",
      "inverse": null,
      "transitive": false
    },
    "see-also": {
      "direction": "symmetric",
      "inverse": null,
      "transitive": false
    }
  },
  "review_days": {
    "normal": 365,
    "critical": 90
  },
  "generated_files": [],
  "ignore": [
    ".github/**",
    "tools/**",
    "assets/**",
    "build/**",
    "src/**",
    "**/node_modules/**",
    "**/__pycache__/**",
    "**/.venv/**"
  ]
}
